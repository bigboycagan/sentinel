# MongoDB connection (kept for template compatibility; SENTINEL stores data in SQLite)
MONGO_URL="mongodb://localhost:27017"
DB_NAME="app"

# Comma-separated list of allowed origins, or * for all
CORS_ORIGINS="*"

# SQLite database file for analysis history + settings (relative paths resolve inside backend/)
SENTINEL_DB_PATH="data/sentinel.db"

# Maximum analyses per IP per minute
ANALYSIS_RATE_LIMIT_PER_MIN="30"

# Public URL of the deployed app (optional)
APP_URL="http://localhost:3000"
